---
import MoneyPageLayout from '../../layouts/MoneyPageLayout.astro';
import { STATES, buildEn } from '../../data/states';
import { guidesForState, stateName } from '../../lib/state-guides';

export async function getStaticPaths() {
  return STATES.map((s) => ({ params: { state: s.slug }, props: { built: buildEn(s) } }));
}

const { built } = Astro.props;
const { state } = Astro.params;
const guides = await guidesForState('en', state as string);
const name = stateName(state as string, 'en');
---
<MoneyPageLayout
  title={built.title}
  h1={built.h1}
  description={built.description}
  path={`/itin-loans/${state}`}
  eyebrow={built.eyebrow}
  lede={built.lede}
  quickAnswer={built.quickAnswer}
  faqs={built.faqs}
>
  {built.sections.map((sec) => (
    <Fragment>
      <h2>{sec.h2}</h2>
      <div set:html={sec.html} />
    </Fragment>
  ))}

  {guides.length > 0 && (
    <Fragment>
      <h2>Guides for {name}</h2>
      <p>Detailed guides for ITIN holders in {name}:</p>
      <ul>
        {guides.map((g) => <li><a href={g.href}>{g.label}</a></li>)}
      </ul>
    </Fragment>
  )}

  <h2>{built.siblingsHeading}</h2>
  <ul>
    {built.siblings.map((sib) => <li><a href={sib.href}>{sib.label}</a></li>)}
  </ul>
</MoneyPageLayout>
