---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Find ITIN Loan Options';
const description =
  'Browse our independent guides to find lenders, loan programs, and credit products available to ITIN holders. No SSN required.';
---
<BaseLayout title={title} description={description} path="/apply" noindex={true}>
  <section class="section">
    <div class="container narrow" style="text-align:center;padding:48px 0">
      <h1>Find ITIN Loan Options</h1>
      <p class="lede" style="margin:0 auto 24px;max-width:36em">
        Browse our guides to find lenders, loan programs, and credit products
        available to ITIN holders across mortgages, auto loans, personal loans,
        business loans, and credit cards.
      </p>
      <a class="btn btn-primary btn-lg" href="/itin-loans">Browse ITIN Loan Guides</a>
      <p style="margin-top:20px"><a href="/articles">See all guides &rarr;</a></p>
    </div>
  </section>
</BaseLayout>
