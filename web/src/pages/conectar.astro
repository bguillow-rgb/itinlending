---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Redirect to the ITIN loans pillar (lead gen removed 2026-08-11).
const target = '/itin-loans';

const title = 'ITIN Loan Resources';
const description =
  'Browse our guides to find ITIN-friendly lenders and loan products.';
---
<BaseLayout title={title} description={description} path="/conectar" noindex={true}>
  <noscript>
    <meta http-equiv="refresh" content={`2;url=${target}`} />
  </noscript>

  <section class="section">
    <div class="container narrow" style="text-align:center">
      <span class="redirect-badge"><Icon name="check" size={34} /></span>
      <h1 style="margin-top:14px">One moment…</h1>
      <p class="lede" style="margin-left:auto;margin-right:auto">
        Taking you to our ITIN loan resource guides.
      </p>
      <a
        id="conectar-link"
        class="btn btn-primary btn-lg"
        href={target}
        style="margin-top:12px"
      >Continue to ITIN Guides</a>
    </div>
  </section>
</BaseLayout>

<style>
  .redirect-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--accent-soft, #ecfdf5); color: var(--accent, #059669);
  }
</style>

<script is:inline define:vars={{ target }}>
  setTimeout(function () {
    window.location.replace(target);
  }, 350);
</script>
