---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

// Redirects to the ES ITIN loans pillar (lead gen removed 2026-08-11).
const target = '/es/itin-loans';

const title = 'Recursos de Préstamos ITIN';
const description =
  'Explora nuestras guías para encontrar prestamistas y programas disponibles para personas con ITIN.';
---
<BaseLayout title={title} description={description} path="/es/conectar" noindex={true}>
  <noscript>
    <meta http-equiv="refresh" content={`2;url=${target}`} />
  </noscript>

  <section class="section">
    <div class="container narrow" style="text-align:center">
      <span class="redirect-badge"><Icon name="check" size={34} /></span>
      <h1 style="margin-top:14px">Un momento…</h1>
      <p class="lede" style="margin-left:auto;margin-right:auto">
        Te llevamos a nuestras guías de préstamos con ITIN.
      </p>
      <a
        id="conectar-link"
        class="btn btn-primary btn-lg"
        href={target}
        style="margin-top:12px"
      >Ir a las guías de ITIN</a>
    </div>
  </section>
</BaseLayout>

<style>
  .redirect-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--accent-soft, #ecfdf5); color: var(--accent, #059669);
  }
</style>

<script is:inline define:vars={{ target }}>
  setTimeout(function () {
    window.location.replace(target);
  }, 350);
</script>
