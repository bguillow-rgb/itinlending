---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Encuentra Opciones de Préstamo con ITIN';
const description =
  'Explora nuestras guías independientes para encontrar prestamistas y programas de crédito disponibles para personas con ITIN. Sin Seguro Social.';
---
<BaseLayout title={title} description={description} path="/es/apply" noindex={true}>
  <section class="section">
    <div class="container narrow" style="text-align:center;padding:48px 0">
      <h1>Encuentra opciones de préstamo con ITIN</h1>
      <p class="lede" style="margin:0 auto 24px;max-width:36em">
        Explora nuestras guías para encontrar prestamistas, programas de préstamo
        y productos de crédito disponibles para personas con ITIN, desde hipotecas
        hasta préstamos de auto, personales, de negocio y tarjetas.
      </p>
      <a class="btn btn-primary btn-lg" href="/es/itin-loans">Ver guías de préstamos con ITIN</a>
      <p style="margin-top:20px"><a href="/es/articles">Ver todas las guías &rarr;</a></p>
    </div>
  </section>
</BaseLayout>
