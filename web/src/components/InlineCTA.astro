---
import { SITE, CTA_FALLBACK_PATH } from '../consts';
import { getLangFromUrl, localizedHref } from '../i18n/ui';

// Reusable CTA dropped mid-article and at the end of money pages. Routes to the
// off-site affiliate partner when one is configured, else to our own /itin-loans
// guide. It never collects reader information — the site runs no lead forms.
interface Props {
  heading?: string;
  sub?: string;
  label?: string;
  // Optional per-product affiliate URL (CJ deep link). Overrides the global
  // affiliateApplyUrl. Empty falls back to global, then to /itin-loans.
  affiliateUrl?: string;
}
const lang = getLangFromUrl(Astro.url);
const {
  heading: headingProp,
  sub: subProp,
  label: labelProp,
  affiliateUrl = '',
} = Astro.props;

const href =
  affiliateUrl || SITE.monetize.affiliateApplyUrl || localizedHref(CTA_FALLBACK_PATH, lang);
const isPartner = href.startsWith('http');

// Copy tracks the destination: an affiliate hand-off says so plainly; the
// internal fallback promises reading, not an application.
const copy =
  lang === 'es'
    ? isPartner
      ? {
          heading: '¿Listo para comparar prestamistas?',
          sub: 'Compara ofertas en el sitio de un socio prestamista. Nosotros no recopilamos tu información.',
          label: 'Comparar en el socio',
        }
      : {
          heading: '¿Quieres entender tus opciones?',
          sub: 'Nuestra guía explica qué prestamistas aceptan ITIN, qué documentos piden y cómo calificar.',
          label: 'Leer la guía de préstamos ITIN',
        }
    : isPartner
      ? {
          heading: 'Ready to compare lenders?',
          sub: "Compare offers on a partner lender's own site. We don't collect your information.",
          label: 'Compare at our partner',
        }
      : {
          heading: 'Want to understand your options?',
          sub: 'Our guide covers which lenders accept an ITIN, what documents they ask for, and how to qualify.',
          label: 'Read the ITIN loan guide',
        };

const heading = headingProp ?? copy.heading;
const sub = subProp ?? copy.sub;
const label = labelProp ?? copy.label;
---
<div class="inline-cta">
  <h3>{heading}</h3>
  <p style="color:var(--muted);max-width:34em;margin:0 auto 18px">{sub}</p>
  <a
    class="btn btn-primary btn-lg"
    href={href}
    {...isPartner ? { rel: 'sponsored nofollow', target: '_blank' } : {}}
  >{label}</a>
</div>
