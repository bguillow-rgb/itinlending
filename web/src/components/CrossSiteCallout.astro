---
// Cross-site router. Card-intent searchers keep landing on this lending site —
// ~85 EN impressions and 6 of the top 19 ES queries in the 2026-07-27 audit are
// "credit cards that accept ITIN" style queries. Sending them to the sister site
// on purpose beats letting them bounce, and the outbound dofollow link is a real
// authority signal between two properties in the same family.
//
// Deliberately NOT noindex on the host page: the goal is to funnel the visitor
// and pass the signal, not to hide the page.
// UTM tagging added 2026-08-17. The 8/17 audit found /itin-credit-cards is now
// the single biggest page on this site by impressions (416 in the 28d to 8/15,
// more than the /itin-loans pillar), and `itin credit card` at position 40.8 is
// the best-positioned commercial query on the property. That is itincreditcard.com
// demand arriving at the wrong domain. This callout already routed it, but
// carried no UTMs, so the handoff was invisible in BOTH GA4 properties: it
// landed in itincreditcard.com's GA4 as generic `itinlending.net / referral`
// with no way to tell a card-router click from a footer link, and it produced
// no event at all on this side. We could not tell whether the router worked.
// Now every click is attributable end to end.
import { tagCrossSite, canonicalPath } from '../lib/cross-site.mjs';

interface Props {
  // Where the visitor actually wants to go.
  href: string;
  // Short question that matches the searcher's intent, not our site structure.
  heading: string;
  body: string;
  cta: string;
  // Sister-site name, shown as the small-caps label.
  site: string;
  // Overrides utm_campaign. Defaults to the card-intent router, which is what
  // every current usage is.
  campaign?: string;
}
const { href, heading, body, cta, site, campaign = 'card-intent-router' } = Astro.props;

// Tagging moved to src/lib/cross-site.mjs on 2026-09-08 so the three surfaces
// that link to a sister site — this component, prose in .astro pages, and plain
// markdown links in article body copy — all stamp the same UTMs from one
// implementation. Behaviour here is unchanged.
const taggedHref = tagCrossSite(href, {
  campaign,
  contentPath: canonicalPath(Astro.url.pathname),
});
---
<aside class="cross-site">
  <span class="cs-label">{site}</span>
  <p class="cs-heading">{heading}</p>
  <p class="cs-body">{body}</p>
  <a class="cs-cta" href={taggedHref} data-cross-site={campaign}>{cta} &rarr;</a>
</aside>
