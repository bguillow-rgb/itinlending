---
import { SITE } from '../consts';

// MarketCall Spanish personal-loans CTA (campaign #350784, offer 9809).
// Replaces the Credit Karma display unit on Spanish pages so every Spanish
// loan-intent click routes to the paid MarketCall funnel instead of an
// unpaid-per-lead Awin unit. Renders nothing when the campaign link is unset
// (dev builds / campaign paused) — pages degrade gracefully, no empty box.
//
// The anchor carries rel="sponsored", which the site-wide Analytics handler
// picks up as an `affiliate_click` GA4 event with network=marketcall — no
// per-component tracking needed. Spanish-only by design: the advertiser's
// funnel is Spanish, and the approved traffic source is itinlending.net SEO.
interface Props {
  inline?: boolean;
}
const { inline = false } = Astro.props;
const mcUrl = SITE.monetize.marketcallPersonalEsUrl;
---
{mcUrl && (
  <div class:list={['mc-cta', { 'mc-cta--inline': inline }]}>
    <div class="mc-head">
      <span class="mc-kicker">De un prestamista asociado</span>
      <span class="mc-disclosure">Anuncio</span>
    </div>
    <p class="mc-title">¿Buscas un préstamo personal con ITIN?</p>
    <p class="mc-note">
      Te conectamos con un prestamista que acepta ITIN. La solicitud es en
      español, toma unos minutos y no necesitas Seguro Social.
    </p>
    <a class="btn btn-primary btn-lg" href={mcUrl} rel="sponsored noopener" target="_blank">
      Ver mis opciones de préstamo <span aria-hidden="true">&rarr;</span>
    </a>
    <p class="mc-fine">
      Serás dirigido al sitio seguro de un prestamista asociado. Podemos recibir
      compensación si tu solicitud es aprobada.
    </p>
  </div>
)}

<style>
  .mc-cta {
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 12px;
    padding: 22px 24px;
    background: var(--surface, #f8fafc);
    text-align: center;
  }
  .mc-cta--inline {
    max-width: 480px;
    margin: 28px auto;
  }
  .mc-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
  }
  .mc-kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted, #64748b);
  }
  .mc-disclosure {
    font-size: 0.7rem;
    color: var(--muted, #94a3b8);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .mc-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .mc-note {
    font-size: 0.95rem;
    color: var(--muted, #475569);
    margin: 0 0 16px;
  }
  .mc-fine {
    font-size: 0.78rem;
    color: var(--muted, #94a3b8);
    margin: 12px 0 0;
  }
</style>
