---
import { SITE } from '../consts';

// GA4 + GSC verification + AdSense loader. All gated on production builds and
// the presence of env-set IDs, so local dev never fires analytics or ads.
//
// AI-referrer tracking uses GA4's built-in referrer dimension. Filter reports
// by referrer matching chatgpt.com / chat.openai.com / perplexity.ai /
// gemini.google.com / claude.ai / copilot.microsoft.com.

const ga4Id = SITE.analytics.ga4Id;
const gsc = SITE.analytics.gscVerification;
const adsense = SITE.monetize.adsenseId;

const isProd = import.meta.env.PROD;
const enableAnalytics = isProd && Boolean(ga4Id);
const enableAds = isProd && Boolean(adsense);
---
{gsc && <meta name="google-site-verification" content={gsc} />}

{enableAnalytics && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Astro wraps a `define:vars` inline script in an IIFE, so the function
      // declaration above is scoped, not global. gtag('config') still worked
      // (it only pushes to dataLayer, which gtag.js reads), so page_view and
      // session_start looked healthy while `window.gtag` stayed undefined and
      // itrack() below silently dropped EVERY custom event. affiliate_click,
      // cta_click and cross_site_click recorded zero from launch until
      // 2026-09-01. Publish it explicitly.
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', ga4Id, { anonymize_ip: true, send_page_view: true });
    </script>
  </>
)}

{enableAds && (
  <>
    <meta name="google-adsense-account" content={adsense} />
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`}
      crossorigin="anonymous"
    ></script>
  </>
)}

{/* Event tracking. Centralized + delegated so it works on every page without
    editing each bespoke component. All calls no-op until GA4 is live (gtag
    absent => itrack does nothing), so this is safe in dev and pre-launch.
    Events: affiliate_click, cta_click. affiliate_click is marked a Key Event in
    GA4. (Lead events removed 2026-08-11 with the lead forms — see
    project-docs/CHANGELOG.md.) */}
<script is:inline>
  (function () {
    function itrack(name, params) {
      if (window.gtag) window.gtag('event', name, params || {});
    }
    window.itrack = itrack;

    // Outbound affiliate clicks (CJ deep links carry rel="sponsored") and
    // internal primary CTAs. page_path gives per-product attribution on money
    // pages. No lead/conversion events — the site collects no visitor data.
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a) return;
      var rel = a.getAttribute('rel') || '';
      var href = a.getAttribute('href') || '';
      if (rel.indexOf('sponsored') > -1) {
        itrack('affiliate_click', { link_url: href, page_path: location.pathname, network: 'cj' });
      } else if (a.hasAttribute('data-cross-site')) {
        // Cross-site router clicks (CrossSiteCallout). Added 2026-08-17 so the
        // card-intent handoff to the sister site is measurable on THIS side too,
        // not just as a UTM'd referral landing over there. Checked before
        // btn-primary because a router CTA may carry both.
        itrack('cross_site_click', {
          link_url: href,
          page_path: location.pathname,
          campaign: a.getAttribute('data-cross-site') || '',
        });
      } else if (a.classList.contains('btn-primary')) {
        itrack('cta_click', { link_url: href, page_path: location.pathname });
      }
    });
  })();
</script>
